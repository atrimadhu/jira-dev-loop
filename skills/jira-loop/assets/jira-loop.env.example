# Copy this file to .claude/jira-loop.env and fill in your values.
# NEVER commit .claude/jira-loop.env — add it to .gitignore in every
# project you drop this folder into.

JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@company.com
# Create at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# "3" = Jira Cloud (default). Use "2" for Jira Server / Data Center.
JIRA_API_VERSION=3

# Optional. If your Jira project has a dedicated "Acceptance Criteria" custom
# field on Story tickets, set its field id here (Settings > Issues > Custom
# Fields, or GET /rest/api/3/field to list ids) so jira-planner can read it
# directly instead of parsing it out of the description text.
# Example: JIRA_ACCEPTANCE_CRITERIA_FIELD=customfield_10014
JIRA_ACCEPTANCE_CRITERIA_FIELD=
